# GEMINI_API_KEY: Optional key for health-report generation.
# Configure this through the deployment environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAYVA_ADMIN_PASSWORD: Required for first-run default admin account (admin@rayva.io) initialization.
RAYVA_ADMIN_PASSWORD=

# Optional Email Delivery Configuration (SMTP provider)
# If not configured, verification & reset tokens are securely hashed and stored, but actual emails are not dispatched.
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

